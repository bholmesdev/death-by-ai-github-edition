# Copy to .env (or .env.local) and fill in. Both the projector and the agent
# control plane read from process.env.

# ---------- Repository the projector reads from ----------
# owner/repo where game:scenario and game:response issues live.
# Default in code: warpdotdev-demos/death-by-ai-github-edition
GITHUB_REPOSITORY=bholmesdev/death-by-ai-github-edition
# Same value, but read by the Python webhook/cron code paths.
WORKFLOW_CODE_REPOSITORY=bholmesdev/death-by-ai-github-edition

# Personal access token (classic or fine-grained) with read access to issues
# on the repo above. Lifts the unauthenticated 60 req/hr ceiling.
GITHUB_TOKEN=

# Optional: point at GitHub Enterprise instead of github.com.
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_SERVER_URL=https://github.com

# ---------- Oz GitHub App (webhook + cron) ----------
OZ_GITHUB_APP_ID=
OZ_GITHUB_APP_PRIVATE_KEY=
OZ_GITHUB_WEBHOOK_SECRET=
# Required for the React Router app to create issues from mobile web forms.
# The value is shown in the GitHub App installation URL and webhook payloads.
OZ_GITHUB_APP_INSTALLATION_ID=

# ---------- Cron auth ----------
# Vercel sets CRON_SECRET automatically in deployed envs; set locally to test.
CRON_SECRET=
# Set to "true" to skip CRON_SECRET check (local only).
OZ_ALLOW_UNAUTHENTICATED_CRON=

# ---------- Warp / Oz cloud runtime ----------
WARP_API_KEY=
WARP_API_BASE_URL=

# ---------- Vercel KV (dispatch queue) ----------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional aliases also supported by the web-form rate limiter:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
